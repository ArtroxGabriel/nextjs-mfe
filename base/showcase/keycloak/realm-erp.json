{
  "realm": "erp",
  "enabled": true,
  "sslRequired": "external",
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": "${ERP_TOKEN_VIDA_S}",
  "ssoSessionIdleTimeout": "${ERP_SESSAO_INATIVIDADE_S}",
  "ssoSessionMaxLifespan": "${ERP_SESSAO_MAXIMA_S}",
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "clients": [
    {
      "clientId": "erp-shell",
      "name": "Shell do ERP (BFF)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${IDP_CLIENTE_SEGREDO}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/api/auth/retorno"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/login"
      },
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "audiencia-erp-dominios",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "erp-dominios",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "ana",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "Operadora",
      "email": "ana@erp.local",
      "credentials": [
        {
          "type": "password",
          "value": "ana",
          "temporary": false
        }
      ]
    },
    {
      "username": "bruno",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bruno",
      "lastName": "Analista",
      "email": "bruno@erp.local",
      "credentials": [
        {
          "type": "password",
          "value": "bruno",
          "temporary": false
        }
      ]
    },
    {
      "username": "carla",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Carla",
      "lastName": "Administradora de Acesso",
      "email": "carla@erp.local",
      "credentials": [
        {
          "type": "password",
          "value": "carla",
          "temporary": false
        }
      ]
    },
    {
      "username": "davi",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Davi",
      "lastName": "Sem Perfil",
      "email": "davi@erp.local",
      "credentials": [
        {
          "type": "password",
          "value": "davi",
          "temporary": false
        }
      ]
    }
  ]
}
