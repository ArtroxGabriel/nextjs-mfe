# Ambiente do showcase. Copie para um arquivo de ambiente local e ajuste; significado de cada
# variável em docs/CONFIGURACAO.md. Os valores abaixo são os padrões.

# Sessão por inatividade: 30 min sem uso encerram a sessão (vida do refresh token)
ERP_SESSAO_INATIVIDADE_S=1800
# Teto absoluto da sessão, mesmo com uso contínuo
ERP_SESSAO_MAXIMA_S=36000
# Vida do access token; o shell renova antes de vencer
ERP_TOKEN_VIDA_S=300
