{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "react": ["../../apps/host/node_modules/@types/react"],
      "react-dom": ["../../apps/host/node_modules/@types/react-dom"]
    }
  },
  "include": ["src/**/*"]
}
